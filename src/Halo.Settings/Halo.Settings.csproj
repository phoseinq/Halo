<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Halo.Settings</AssemblyName>
    <RootNamespace>Halo.Settings</RootNamespace>
    <ApplicationIcon>..\Halo.App\Assets\halo.ico</ApplicationIcon>
    <!-- WPF, not WinUI: the design is the same and the compositor path for acrylic is the same DWM call,
         but the Windows App SDK would have added 145MB to a 109MB install for one window. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>


  <ItemGroup>
    <Resource Include="..\Halo.App\Assets\halo.ico" Link="halo.ico" />
    <!-- the same file on disk as Halo.App embeds, under the same logical name, because Strings reads it
         out of ITS OWN assembly - a linked class in a second exe finds a second copy or finds nothing -->
    <EmbeddedResource Include="..\Halo.App\Localization\locales\en.json"
                      LogicalName="Halo.Localization.en.json" />
    <!-- and the loose ones beside the exe, the same way Halo.App ships them. Strings.LocalesDir resolves
         next to the ASSEMBLY, so the panel was looking in its own output folder and finding nothing: the
         language picker offers only what Available() can see, so without this it offered English alone
         however many locale files the repo carried. -->
    <Content Include="..\Halo.App\Localization\locales\*.json"
             Exclude="..\Halo.App\Localization\locales\en.json"
             Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- shared with Halo.App rather than duplicated, like halo.ico above: the startup row has to know
         whether it is describing a scheduled task or a package-declared one -->
    <Compile Include="..\Halo.App\Interop\AppModel.cs" Link="AppModel.cs" />
    <!-- the panel writes "undone" here and the pill reads it; one definition of the format, not two -->
    <Compile Include="..\Halo.App\ClaudeCode\HookMarks.cs" Link="HookMarks.cs" />
    <!-- the third linked file, for the same reason as the other two: a key table is a format, and both
         exes reading one settings.json have to resolve it identically. The twinning that Intake and
         Destination use is about one exe not being able to stop the other STARTING; this is not that. -->
    <Compile Include="..\Halo.App\Localization\Strings.cs" Link="Strings.cs" />
    <!-- the fourth, and the one that has to be shared rather than twinned: the pill writes the request stamp
         and the panel consumes it, so the path, the format and the freshness window are one definition -->
    <Compile Include="..\Halo.App\Shell\PanelLaunch.cs" Link="PanelLaunch.cs" />
    <!-- the fifth, for exactly the reason Strings.cs gives: the Quick Actions catalogue IS a key table.
         The panel writes quick.<id> and the launcher decides what to show from the same ids and the same
         defaults, so two copies would disagree the first time an action was added to one of them. -->
    <Compile Include="..\Halo.App\Launcher\QuickActions.cs" Link="QuickActions.cs" />
    <!-- Its own file precisely so both sides can have it: the panel needs to turn a keypress into
         "Ctrl+Alt+H" and the pill needs to turn that back into RegisterHotKey arguments, and neither
         should own a second copy of the spelling. -->
    <Compile Include="..\Halo.App\Launcher\HotKeyChord.cs" Link="HotKeyChord.cs" />
  </ItemGroup>

</Project>
