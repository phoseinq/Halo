<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- installer/ and hooks/ are private; the public mirror ships src/ and tests/ only. The tests that read
       those files compile only where they exist, so the mirror's CI is not asked to assert about a file it
       was never given. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\installer\Halo.iss')">
    <DefineConstants>$(DefineConstants);HALO_PRIVATE_ASSETS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Halo.App is the canonical copy of the two shared files: AppModel.cs is linked into all three exes
         and HookMarks.cs into two, so with all three referenced plainly, naming either type here is CS0433
         "exists in both" - which is exactly what happened the first time a test tried to write
         HookMarks.Done. It also meant every packaged branch was untestable, since AppModel is the thing
         those branches ask.

         Aliasing the two duplicating assemblies takes their copies out of the global namespace, so the
         unqualified name resolves to Halo.App's - the file the others link. It costs one `extern alias`
         line in the three test files that name a Halo.Hooks type; nothing in src changes, which is the
         reason to prefer it over a fourth shared assembly. That would have put another DLL beside the
         deliberately tiny hooks exe and quietly broken the documented four-file hook quick-deploy. -->
    <ProjectReference Include="..\..\src\Halo.App\Halo.App.csproj" />
    <ProjectReference Include="..\..\src\Halo.Hooks\Halo.Hooks.csproj">
      <Aliases>hooksasm</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Halo.Settings\Halo.Settings.csproj">
      <Aliases>settingsasm</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
