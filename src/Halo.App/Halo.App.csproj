<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Halo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\halo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\uia-cancel.ps1" LogicalName="Halo.Assets.uia-cancel.ps1" />
    <EmbeddedResource Include="Assets\claude.png" />
    <EmbeddedResource Include="Assets\openai.png" LogicalName="Halo.Assets.openai.png" />
    <!-- LogicalName rather than the default Halo.Localization.locales.en.json, because Halo.Settings
         embeds this same file from a relative path and the two default names would not match -->
    <EmbeddedResource Include="Localization\locales\en.json" LogicalName="Halo.Localization.en.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- both shipping paths take the publish directory wholesale - Halo.iss recurses {#Payload}\* and
         build-msix.ps1 copies the layout - so a locales\ folder in the output needs no installer edit.
         en.json is excluded because it is embedded; a loose copy would be a second source of truth. -->
    <Content Include="Localization\locales\*.json" Exclude="Localization\locales\en.json"
             Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
